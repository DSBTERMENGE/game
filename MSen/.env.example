# Copie para .env apenas se o processo usado para iniciar a aplicação carregar
# esse arquivo. Nunca coloque a senha real neste exemplo nem o versione.
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=5432
GAME_DB_NAME=games
GAME_DB_USER=game_app
